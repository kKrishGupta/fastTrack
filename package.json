{
  "name": "facetrack-pro",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "check": "npm run test && npm run test:agent && npm run test:installer && npm run build",
    "test:agent": "node --test facetrack-sync-agent/*.test.mjs",
    "test:installer": "node --test installer/*.test.mjs",
    "agent:preview": "node facetrack-sync-agent/index.mjs preview",
    "agent:pair": "node facetrack-sync-agent/index.mjs pair",
    "agent:start": "node facetrack-sync-agent/index.mjs run",
    "installer:stage": "node installer/build.mjs --refresh-bridge --stage-only",
    "installer:build:test": "node installer/build.mjs --compile-only --nsis --internal-test-build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "object-inspect": "^1.13.4"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "concurrently": "^9.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^8.3.8"
  }
}
