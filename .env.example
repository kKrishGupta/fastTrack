NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/facetrack_pro
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_HOURS=8
EMPLOYEE_INVITE_HOURS=168
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=attendance@your-verified-domain.com
CHALLENGE_MINUTES=5
TRUST_PROXY=false
ALLOW_TEST_FACE_ADAPTER=true
# Explicit opt-in for deployed demos. This stores encrypted capture evidence but is not identity recognition.
ALLOW_DEMO_FACE_ADAPTER=false
DEV_LOCATION_ACCURACY_MAX=150
FACE_PROVIDER=none
# Required when FACE_PROVIDER=aws-rekognition
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=replace-with-aws-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# BIOMETRIC_KEY=replace-with-generated-base64-key
FACE_SIMILARITY_THRESHOLD=90
FACE_EVIDENCE_RETENTION_DAYS=30

# ActivityWatch uses employee device pairing; no provider API key is required.


