NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/facetrack_pro
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_HOURS=8
EMPLOYEE_INVITE_HOURS=168
GMAIL_USER=your-google-account@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
CHALLENGE_MINUTES=5
TRUST_PROXY=false
ALLOW_TEST_FACE_ADAPTER=true
DEV_LOCATION_ACCURACY_MAX=150
BIOMETRIC_KEY=base64-encoded-32-byte-key
FACE_MODEL_ID=arcface-onnx-configure-model
FACE_SIMILARITY_THRESHOLD=0.68

